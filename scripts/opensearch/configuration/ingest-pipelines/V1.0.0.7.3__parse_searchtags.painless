// Expands the flattened `searchtags` taxonomy into one facet family per group.
//
// The producer copies `<meta name="searchtags">` verbatim into
// payload.facets.searchtags as a single string, e.g.
//
//   Arbory Display | Content type / Blogs, Arbory Display | tags / AEM,
//   Arbory Display | tags / ci-cd, Arbory Display | Category / AEM News
//
// The element after the pipe is the group, and each group becomes its own
// top-level facet:
//
//   content_type_level0 ["Blogs"]                     -> renders as "Content Type"
//   tags_level0         ["AEM", "ci-cd"]              -> renders as "Tags"
//   categories_level0   ["AEM News"]                  -> renders as "Categories"
//   category_hierarchy  ["Blogs", "AEM", "ci-cd", "AEM News",
//                        "Content type>Blogs", "tags>AEM",
//                        "tags>ci-cd", "Category>AEM News"]
//
// The UI builds one facet block per aggregation the response carries, and derives
// each heading from the field name by stripping `_level<n>` and turning `_` into
// spaces - hence `content_type_level0` -> "Content Type". The search template has
// to aggregate these three fields explicitly, since the client only ever requests
// one family (its facetFieldPrefix).
//
// Each family is written FLAT, one level only. OpenSearch cannot correlate
// positions across two independent arrays, so nesting a level1 terms agg under a
// level0 bucket returns every level1 value of the matching documents rather than
// that bucket's children. Splitting by group is what gives the grouping instead.
//
// category_hierarchy stays the single filter field (facetFilterField) shared by
// every family, because the client sends one filter field name for all trees. It
// holds the bare leaves - what a selection actually filters on - plus the
// group>leaf paths. Selections within a family are OR-ed and across families
// AND-ed, which is the intended behaviour.
//
// String literals are single-quoted so the source survives JSON embedding, and no
// regex is used because painless regexes are disabled by default.
if (ctx.payload == null) {
  return;
}
def facets = ctx.payload.facets;
if (facets == null) {
  return;
}
def raw = facets.searchtags;
if (raw == null) {
  return;
}

String source;
if (raw instanceof List) {
  StringBuilder joined = new StringBuilder();
  for (def part : (List) raw) {
    if (joined.length() > 0) {
      joined.append(',');
    }
    joined.append(part);
  }
  source = joined.toString();
} else {
  source = raw.toString();
}

// A comma only starts a new entry when the fragment after it carries the
// '<namespace> | <group> / <value>' shape. Fragments with no '|' are a comma that
// belongs inside the previous entry's value.
List entries = new ArrayList();
for (String fragment : source.splitOnToken(',')) {
  if (entries.isEmpty() || fragment.indexOf('|') >= 0) {
    entries.add(fragment);
  } else {
    int last = entries.size() - 1;
    entries.set(last, (String) entries.get(last) + ',' + fragment);
  }
}

// Group name -> field prefix. Anything unmapped is sanitised, so a new group
// starts faceting on its own without a pipeline change.
Map known = ['content type': 'content_type', 'tags': 'tags', 'category': 'categories'];

Map families = new HashMap();
List hierarchy = new ArrayList();

for (String entry : entries) {
  int bar = entry.indexOf('|');
  if (bar < 0) {
    continue;
  }
  String path = entry.substring(bar + 1).trim();
  // First ' / ' only, so a value that still contains a slash stays intact.
  int slash = path.indexOf(' / ');
  if (slash < 0) {
    continue;
  }
  String group = path.substring(0, slash).trim();
  String leaf = path.substring(slash + 3).trim();
  if (group.length() == 0 || leaf.length() == 0) {
    continue;
  }

  String lower = group.toLowerCase();
  String field;
  if (known.containsKey(lower)) {
    field = (String) known.get(lower);
  } else {
    StringBuilder safe = new StringBuilder();
    for (int i = 0; i < lower.length(); i++) {
      char c = lower.charAt(i);
      if (Character.isLetterOrDigit(c)) {
        safe.append(c);
      } else {
        safe.append('_');
      }
    }
    field = safe.toString();
  }

  if (!families.containsKey(field)) {
    families.put(field, new ArrayList());
  }
  List bucket = (List) families.get(field);
  if (!bucket.contains(leaf)) {
    bucket.add(leaf);
  }

  // Bare leaf first: a selection filters on exactly this.
  if (!hierarchy.contains(leaf)) {
    hierarchy.add(leaf);
  }
  String nested = group + '>' + leaf;
  if (!hierarchy.contains(nested)) {
    hierarchy.add(nested);
  }
}

if (!families.isEmpty()) {
  for (def family : families.entrySet()) {
    facets[(String) family.getKey() + '_level0'] = family.getValue();
  }
  facets.category_hierarchy = hierarchy;
}
