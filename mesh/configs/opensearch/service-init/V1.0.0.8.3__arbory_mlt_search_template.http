POST /_scripts/arbory-mlt
Content-Type: application/json

{
  "script": {
    "lang": "mustache",
    "source": "{\n  \"_source\": [\n    \"_id\",\n    \"payload.title\",\n    \"payload.description\",\n    \"payload.date\",\n    \"payload.image\",\n    \"payload.facets.content_type_level0\",\n    \"payload.facets.author_level0\",\n    \"namespace\"\n  ],\n  {{#size}}\"size\": \"{{size}}\",{{/size}}\n  {{^size}}\"size\": \"3\",{{/size}}\n  \"query\": {\n    \"bool\": {\n      \"filter\": [\n        { \"regexp\": { \"type.keyword\": \".*page.*\" } },\n        { \"term\": { \"namespace.keyword\": { \"value\": \"{{namespace}}\", \"case_insensitive\": true } } }\n        {{#content_type}}, { \"term\": { \"payload.facets.content_type_level0.keyword\": \"{{content_type}}\" } }{{/content_type}}\n      ],\n      \"must_not\": [\n        { \"regexp\": { \"type.keyword\": \".*fragment.*\" } }\n        {{#exclude}}, { \"ids\": { \"values\": [ \"{{exclude}}\" ] } }{{/exclude}}\n      ],\n      \"must\": [\n        {\n          \"more_like_this\": {\n            \"fields\": [ \"payload.title\", \"payload.description\", \"payload.content\" ],\n            \"like\": [\n              {{#id}}{ \"_id\": \"{{id}}\" }{{#text}},{{/text}}{{/id}}\n              {{#text}}\"{{text}}\"{{/text}}\n            ],\n            \"min_term_freq\": 1,\n            \"min_doc_freq\": 2,\n            \"max_query_terms\": 40,\n            \"min_word_length\": 3,\n            \"minimum_should_match\": \"{{minimum_should_match}}{{^minimum_should_match}}10%{{/minimum_should_match}}\"\n          }\n        }\n      ],\n      \"should\": [\n        { \"more_like_this\": {\n            \"fields\": [ \"payload.title\" ],\n            \"like\": [\n              {{#id}}{ \"_id\": \"{{id}}\" }{{#text}},{{/text}}{{/id}}\n              {{#text}}\"{{text}}\"{{/text}}\n            ],\n            \"min_term_freq\": 1,\n            \"min_doc_freq\": 1,\n            \"max_query_terms\": 12,\n            \"min_word_length\": 3,\n            \"boost\": 2\n        } }\n      ]\n    }\n  }\n}\n"
  }
}
