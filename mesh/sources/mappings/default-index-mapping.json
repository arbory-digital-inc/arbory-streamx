{
  "properties": {
    "payload": {
      "properties": {
        "date": {
          "type": "date",
          "format": "strict_date_optional_time||yyyy-MM-dd||yyyy-MM||epoch_millis",
          "ignore_malformed": true
        },
        "description": {
          "type": "text",
          "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } }
        },
        "image": { "type": "keyword", "index": false },
        "facets": {
          "properties": {
            "content_type_level0": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "topic_level0":        { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "technology_level0":   { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "year_level0":         { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "author_level0":       { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "category_hierarchy":  { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } }
          }
        }
      }
    }
  }
}
