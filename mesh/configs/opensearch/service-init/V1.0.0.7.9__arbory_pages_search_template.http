POST /_scripts/arbory-pages
Content-Type: application/json

{
  "script": {
    "lang": "mustache",
    "source": "{\n  \"_source\": [\n    \"_id\",\n    \"payload.title\",\n    \"payload.description\",\n    \"payload.date\",\n    \"payload.ingested\",\n    \"payload.facets.content_type_level0\",\n    \"fragments.*\",\n    \"type\",\n    \"namespace\"\n  ],\n  \"from\": {{from}}{{^from}}0{{/from}},\n  {{#size}}\"size\": \"{{size}}\",{{/size}}\n  {{^size}}\"size\": \"50\",{{/size}}\n  {{#sort}}\n  \"sort\": [\n    {\n      \"_script\": {\n        \"type\": \"number\",\n        \"order\": \"asc\",\n        \"script\": {\n          \"lang\": \"painless\",\n          \"source\": \"/*\\n * Date sort for the search template. `params.spec` is the raw `sort` parameter\\n * the front end sends: \\\"date:desc\\\" (its only value today) or \\\"date:asc\\\".\\n *\\n * WHY A SCRIPT SORT rather than {\\\"payload.date\\\":{\\\"order\\\":\\\"desc\\\"}}.\\n * A search template is mustache over JSON and cannot branch on a parameter's\\n * VALUE, so a plain field sort would have to hardcode one direction and silently\\n * ignore the other. Silently is the problem: the reference deployment accepts\\n * `sort` today, returns a clean 200 and changes nothing, because the parameter is\\n * not in its template at all. The toggle flips, the URL updates, the order does\\n * not change, and nothing logs. A script reads the direction instead.\\n *\\n * UNDATED DOCUMENTS SORT LAST IN BOTH DIRECTIONS. Pages without a date \\u2014\\n * hub pages, landing pages, fragments \\u2014 treating them as\\n * very old or very new would hand the reader a screenful of them at one end. The sort\\n * runs ascending over this script's output, so Long.MAX_VALUE is \\\"last\\\" whichever\\n * direction was asked for, and descending is expressed by negating the millis\\n * rather than by flipping the sort.\\n *\\n * RELEVANCE IS THE DEFAULT and is the ABSENCE of a sort: the template emits this\\n * clause only inside its `sort` section, so with no parameter the index answers\\n * in _score order.\\n *\\n * NOTHING IN THIS FILE MAY CONTAIN A MUSTACHE TAG, not even in a comment. This\\n * script is embedded INSIDE the search template, so the template engine parses\\n * these comments too: a stray section opener here pairs with the template's own\\n * closer and the template stops compiling. scripts/mesh/build-migrations.py refuses to build it.\\n */\\nString spec = '';\\nif (params.spec != null) {\\n  spec = params.spec;\\n}\\nif (!doc.containsKey('payload.date')) {\\n  return Long.MAX_VALUE;\\n}\\ndef field = doc['payload.date'];\\nif (field.size() == 0) {\\n  return Long.MAX_VALUE;\\n}\\nlong millis = field.value.toInstant().toEpochMilli();\\nif (spec.endsWith(':asc')) {\\n  return millis;\\n}\\nreturn -millis;\",\n          \"params\": { \"spec\": \"{{sort}}\" }\n        }\n      }\n    }\n  ],\n  {{/sort}}\n  \"query\": {\n    \"bool\": {\n      \"filter\": [\n        { \"regexp\": { \"type.keyword\": \".*page.*\" } }\n        {{#filter_query}}, {{#fields}} { \"terms\": { \"payload.facets.{{name}}.keyword\": {{#toJson}}values{{/toJson}} } }{{^last}},{{/last}} {{/fields}} {{/filter_query}}\n      ],\n      \"must\": [\n        { \"match_all\": {} },\n        { \"bool\": { \"must_not\": { \"regexp\": { \"type.keyword\": \".*fragment.*\" } } } }\n        {{#namespace}}, { \"prefix\": { \"namespace.keyword\": { \"case_insensitive\": true, \"value\": \"{{namespace}}\" } } } {{/namespace}}\n        {{#query}},\n        {{^operators}}\n        {\n          \"bool\": {\n            \"should\": [\n              { \"match_bool_prefix\": { \"payload.title\":       { \"query\": \"{{query}}\" } } },\n              { \"match_bool_prefix\": { \"payload.description\": { \"query\": \"{{query}}\" } } },\n              { \"match_bool_prefix\": { \"payload.content\":     { \"query\": \"{{query}}\" } } },\n              { \"nested\": { \"path\": \"fragments\", \"query\": { \"bool\": { \"should\": [ { \"match_bool_prefix\": { \"fragments.payload.content\": { \"query\": \"{{query}}\" } } } ] } } } }\n            ]\n          }\n        },\n        {{/operators}}\n        {{#operators}}\n        {\n          \"bool\": {\n            \"should\": [\n              {{#any_of}}\n              { \"bool\": { \"must\": [\n                {{#all_of}}\n                { \"bool\": { \"must\": [\n                  {{#text}}\n                  { \"bool\": { \"should\": [\n                    { \"match_bool_prefix\": { \"payload.title\":       { \"query\": \"{{text}}\" } } },\n                    { \"match_bool_prefix\": { \"payload.description\": { \"query\": \"{{text}}\" } } },\n                    { \"match_bool_prefix\": { \"payload.content\":     { \"query\": \"{{text}}\" } } },\n                    { \"nested\": { \"path\": \"fragments\", \"query\": { \"bool\": { \"should\": [ { \"match_bool_prefix\": { \"fragments.payload.content\": { \"query\": \"{{text}}\" } } } ] } } } }\n                  ] } }{{#has_phrases}},{{/has_phrases}}\n                  {{/text}}\n                  {{#phrases}}\n                  { \"bool\": { \"should\": [\n                    { \"match_phrase\": { \"payload.title\":       { \"query\": \"{{phrase}}\" } } },\n                    { \"match_phrase\": { \"payload.description\": { \"query\": \"{{phrase}}\" } } },\n                    { \"match_phrase\": { \"payload.content\":     { \"query\": \"{{phrase}}\" } } },\n                    { \"nested\": { \"path\": \"fragments\", \"query\": { \"bool\": { \"should\": [ { \"match_phrase\": { \"fragments.payload.content\": { \"query\": \"{{phrase}}\" } } } ] } } } }\n                  ] } }{{^last_phrase}},{{/last_phrase}}\n                  {{/phrases}}\n                ] } }{{^last_term}},{{/last_term}}\n                {{/all_of}}\n              ] } }{{^last_group}},{{/last_group}}\n              {{/any_of}}\n            ]\n          }\n        },\n        {{/operators}}\n        { \"bool\": { \"filter\": [ { \"match_all\": {} } ], \"should\": [ { \"match\": { \"payload.title\": { \"query\": \"{{query}}\", \"boost\": 2 } } } ] } },\n        { \"bool\": { \"filter\": [ { \"match_all\": {} } ], \"should\": [ { \"multi_match\": { \"query\": \"{{query}}\", \"type\": \"most_fields\", \"fields\": [ \"payload.facets.topic_level0\", \"payload.facets.technology_level0\" ], \"boost\": 2 } } ] } }\n        {{/query}}\n      ]\n    }\n  },\n  \"highlight\": {\n    \"fields\": {\n      \"payload.title\": {},\n      \"payload.description\": {},\n      \"payload.content\": {},\n      \"fragments.payload.content\": {}\n    }\n  },\n  \"track_scores\": true,\n  \"aggs\": {\n    \"content_type_level0\": { \"terms\": { \"field\": \"payload.facets.content_type_level0.keyword\", \"size\": 20 } },\n    \"topic_level0\":        { \"terms\": { \"field\": \"payload.facets.topic_level0.keyword\",        \"size\": 50 } },\n    \"technology_level0\":   { \"terms\": { \"field\": \"payload.facets.technology_level0.keyword\",   \"size\": 50 } },\n    \"year_level0\":         { \"terms\": { \"field\": \"payload.facets.year_level0.keyword\",         \"size\": 30 } },\n    \"author_level0\":       { \"terms\": { \"field\": \"payload.facets.author_level0.keyword\",       \"size\": 60 } }\n    {{#facets}}, {{#fields}} \"{{name}}\": { \"terms\": { \"field\": \"payload.facets.{{name}}.keyword\", \"size\": {{size}}{{^size}}20{{/size}} } {{#children}}, \"aggs\": { \"{{name}}\": { \"terms\": { \"field\": \"payload.facets.{{name}}.keyword\", \"size\": {{size}}{{^size}}20{{/size}} } {{#children}}, \"aggs\": { \"{{name}}\": { \"terms\": { \"field\": \"payload.facets.{{name}}.keyword\", \"size\": {{size}}{{^size}}20{{/size}} } } } {{/children}} }{{^last}},{{/last}} } {{/children}} }{{^last}},{{/last}} {{/fields}} {{/facets}}\n  }\n}\n"
  }
}
